# ---------- Data backend ----------
# "sheets" = Google Sheet (production). "memory" = in-memory demo data (no Google needed).
DATA_BACKEND=sheets

# The spreadsheet ID is the long part of the sheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=

# Service account (from the JSON key file). Keep the \n sequences in the private key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Sign-in (Google OAuth) ----------
NEXTAUTH_URL=http://localhost:3000
# Generate with: npx auth secret   (or any long random string)
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Always-allowed partner emails (bootstrap, before the Users tab is filled). Comma separated.
BOOTSTRAP_PARTNER_EMAILS=rajitha93725@gmail.com

# Owner(s): full access, including MO Villa, Cash & bank, Settings and Users. Other partners see the cafe only.
# Set here (server config), never in the sheet, so nobody can give themselves owner access from the app.
# Defaults to BOOTSTRAP_PARTNER_EMAILS when empty.
OWNER_EMAILS=rajitha93725@gmail.com

# Local demo only: skip Google sign-in and act as this role (owner | partner | staff). Never set in production.
AUTH_DISABLED=false
DEMO_ROLE=owner
