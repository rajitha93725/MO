# ---------- Data backend ----------
# "supabase" = Supabase database (production). "memory" = in-memory demo data.
DATA_BACKEND=supabase

# Supabase project URL and SECRET key (sb_secret_...). Server only - never commit the key.
SUPABASE_URL=https://wlxjvghrlspurnslimkx.supabase.co
SUPABASE_SECRET_KEY=

# ---------- Sign-in (username + password, or Google OAuth) ----------
NEXTAUTH_URL=http://localhost:3000
# Generate with: npx auth secret   (or any long random string)
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Always-allowed partner emails (bootstrap, before the Users table is filled). Comma separated.
BOOTSTRAP_PARTNER_EMAILS=rajitha93725@gmail.com

# Owner(s): full access, including MO Villa, Cash & bank, Settings and Users. Other partners see the cafe only.
# Set here (server config), never in the database, so nobody can give themselves owner access from the app.
# Defaults to BOOTSTRAP_PARTNER_EMAILS when empty.
OWNER_EMAILS=rajitha93725@gmail.com

# Local demo only: skip sign-in and act as this role (owner | partner | staff). Never set in production.
AUTH_DISABLED=false
DEMO_ROLE=owner
